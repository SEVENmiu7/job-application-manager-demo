{
  "id": "job-info-extractor",
  "pluginKey": "@official-plugins/ai-text-to-json",
  "pluginVersion": "1.0.24",
  "name": "岗位信息结构化",
  "description": "将招聘页面或用户粘贴的岗位文本转换为投递记录字段",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "job_text": {
        "type": "string",
        "description": "待提取的岗位招聘文本"
      }
    },
    "required": ["job_text"]
  },
  "formValue": {
    "modelID": "2015",
    "modelParams": {
      "temperature": 0.2,
      "maxTokens": 8192
    },
    "prompt": "你是一名严谨的招聘信息整理助手。\n\n请从下方岗位文本中提取可用于求职投递追踪的信息：\n{{input.job_text}}\n\n要求：\n1. 只提取原文中能确认的内容，不猜测公司、地点、行业或薪资。\n2. 工作地区优先输出城市名；无法确认时留空。\n3. 职能方向仅从产品、运营、市场、技术、职能、其他中选一项。\n4. 所属行业仅从互联网、金融、咨询、电商、教育、其他中选一项；无法确认时留空。\n5. 岗位职责和任职要求保留关键要点，不添加原文不存在的内容。",
    "jsonStructure": [
      {
        "name": "companyName",
        "paramType": "String",
        "paramDescription": "公司名称"
      },
      {
        "name": "jobTitle",
        "paramType": "String",
        "paramDescription": "岗位名称"
      },
      {
        "name": "location",
        "paramType": "String",
        "paramDescription": "工作城市或地区"
      },
      {
        "name": "industry",
        "paramType": "String",
        "paramDescription": "所属行业"
      },
      {
        "name": "functionDirection",
        "paramType": "String",
        "paramDescription": "职能方向"
      },
      {
        "name": "salary",
        "paramType": "String",
        "paramDescription": "薪资范围及薪资结构"
      },
      {
        "name": "responsibilities",
        "paramType": "String",
        "paramDescription": "岗位职责要点"
      },
      {
        "name": "requirements",
        "paramType": "String",
        "paramDescription": "任职要求要点"
      }
    ]
  },
  "createdAt": 1786807251273,
  "updatedAt": 1786807251273
}
